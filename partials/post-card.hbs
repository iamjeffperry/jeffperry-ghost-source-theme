<article
    class="gh-card jp-entry {{post_class}}{{#has tag="#micro"}} is-short{{/has}}{{#has tag="#image"}} is-image{{/has}}{{#has tag="#link"}} is-link{{/has}}{{#has tag="#media"}} is-media{{/has}}{{#unless @custom.show_images_in_feed}} no-image{{/unless}}"
    style="
        {{#foreach tags visibility="all"}}
            {{#match name "#micro"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#image"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#link"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
            {{#match name "#media"}}{{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}{{/match}}
        {{/foreach}}
    "
>
    <div class="jp-entry-meta">
        <a class="jp-entry-time" href="{{url}}" aria-label="Permalink to {{title}}">
            <time datetime="{{date format="YYYY-MM-DDTHH:mm:ssZ"}}">{{date format="MMM D · h:mm A"}}</time>
        </a>

        <span class="jp-entry-kind">
            {{#has tag="#micro"}}Note
            {{else}}{{#has tag="#image"}}Photo
            {{else}}{{#has tag="#link"}}Link
            {{else}}{{#has tag="#media"}}Media
            {{else}}Post{{/has}}{{/has}}{{/has}}{{/has}}
        </span>

        {{#if primary_tag}}
            <span class="jp-entry-topic">{{primary_tag.name}}</span>
        {{/if}}
    </div>

    <div class="jp-entry-body">

        {{!-- Images get room to breathe, but do not dominate every type of entry. --}}
        {{#if feature_image}}
            <a class="jp-entry-image-link" href="{{url}}">
                <figure class="jp-entry-image">
                    <img
                        srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                                {{img_url feature_image size="m" format="webp"}} 600w,
                                {{img_url feature_image size="l" format="webp"}} 960w,
                                {{img_url feature_image size="xl" format="webp"}} 1200w"
                        sizes="(max-width: 700px) 100vw, 720px"
                        src="{{img_url feature_image size="m"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        {{#if lazyLoad}}loading="lazy"{{/if}}
                    >
                </figure>
            </a>
        {{/if}}

        {{!-- Notes and link posts are intentionally lighter than full articles. --}}
        {{#has tag="#micro"}}
            {{#if custom_excerpt}}
                <div class="jp-entry-note is-body">{{custom_excerpt}}</div>
            {{else}}
                <div class="jp-entry-note is-body">{{excerpt words="80"}}</div>
            {{/if}}

        {{else}}
            {{#has tag="#link"}}
                <div class="jp-entry-content jp-entry-link-content is-body">
                    {{content}}
                </div>

            {{else}}
                {{#has tag="#media"}}
                    <h2 class="jp-entry-title is-title"><a href="{{url}}">{{title}}</a></h2>
                    <div class="jp-entry-content jp-entry-media-content is-body">
                        {{content}}
                    </div>

                {{else}}
                    {{#has tag="#image"}}
                        <h2 class="jp-entry-title is-title"><a href="{{url}}">{{title}}</a></h2>
                        <div class="jp-entry-content jp-entry-image-content is-body">
                            {{content}}
                        </div>

                    {{else}}
                        <h2 class="jp-entry-title is-title"><a href="{{url}}">{{title}}</a></h2>

                        {{#if custom_excerpt}}
                            <p class="jp-entry-excerpt is-body">{{custom_excerpt}}</p>
                        {{else}}
                            {{#if excerpt}}
                                <p class="jp-entry-excerpt is-body">{{excerpt words="55"}}</p>
                            {{/if}}
                        {{/if}}

                        <a class="jp-entry-read-more" href="{{url}}">Continue reading →</a>
                    {{/has}}
                {{/has}}
            {{/has}}
        {{/has}}
    </div>
</article>
