<article
    class="gh-card {{post_class}}{{#has tag="#micro"}} is-short{{/has}}{{#has tag="#image"}} is-image{{/has}}{{#has tag="#link"}} is-link{{/has}}{{#has tag="#media"}} is-media{{/has}}{{#unless @custom.show_images_in_feed}} no-image{{/unless}}"
    style="
        {{#foreach tags visibility="all"}}
            {{#match name "#micro"}}
                {{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}
            {{/match}}

            {{#match name "#image"}}
                {{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}
            {{/match}}

            {{#match name "#link"}}
                {{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}
            {{/match}}
            {{#match name "#media"}}
                {{#if accent_color}}--post-type-color: {{accent_color}};{{/if}}
            {{/match}}
        {{/foreach}}
    "
>

    <div class="gh-card-link">

        {{!-- Feature image for standard posts --}}
        {{#if feature_image}}
            <a class="gh-card-image-link" href="{{url}}">
                <figure class="gh-card-image">
                    <img
                        srcset="{{img_url feature_image size="xs" format="webp"}} 160w,
                                {{img_url feature_image size="s" format="webp"}} 320w,
                                {{img_url feature_image size="m" format="webp"}} 600w,
                                {{img_url feature_image size="l" format="webp"}} 960w,
                                {{img_url feature_image size="xl" format="webp"}} 1200w,
                                {{img_url feature_image size="xxl" format="webp"}} 2000w"
                        sizes="{{#if imageSizes}}{{imageSizes}}{{else}}320px{{/if}}"
                        src="{{img_url feature_image size="m"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        {{#if lazyLoad}}loading="lazy"{{/if}}
                    >
                </figure>
            </a>
        {{/if}}

        <div class="gh-card-wrapper">

            {{!-- Post type label --}}
            {{#has tag="#micro"}}
                <p class="gh-card-type">Micro</p>
            {{else}}
                {{#has tag="#image"}}
                    <p class="gh-card-type">Photo</p>
                {{else}}
                    {{#has tag="#link"}}
                        <p class="gh-card-type">Link</p>
                    {{else}}
                        {{#has tag="#media"}}
                            <p class="gh-card-type">Media</p>
                        {{else}}
                            <p class="gh-card-type">Essay</p>
                        {{/has}}
                    {{/has}}
                {{/has}}
            {{/has}}

            {{!-- Public tag, if one exists --}}
            {{#if primary_tag}}
                <p class="gh-card-tag">{{primary_tag.name}}</p>
            {{/if}}

            {{!--
                Titles:
                Short and link posts intentionally have no visible title.
                Other posts keep their title, which links to the post.
            --}}
            {{#has tag="#micro"}}

            {{else}}
                {{#has tag="#link"}}

                {{else}}
                    <h3 class="gh-card-title is-title">
                        <a href="{{url}}">{{title}}</a>
                    </h3>
                {{/has}}
            {{/has}}

            {{!-- Post content / excerpts --}}
            {{#has tag="#link"}}

                <div class="gh-link-content">
                    {{content}}
                </div>

            {{else}}

                {{#has tag="#media"}}

                    <div class="gh-media-content">
                        {{content}}
                    </div>

                {{else}}

                    {{#has tag="#image"}}

                        <div class="gh-image-content">
                            {{content}}
                        </div>

                    {{else}}

                        {{#if custom_excerpt}}
                            <p class="gh-card-excerpt is-body{{#has tag="#micro"}} is-short-excerpt{{/has}}">
                                {{custom_excerpt}}
                            </p>
                        {{/if}}

                        {{#unless custom_excerpt}}
                            {{#if excerpt}}
                                <p class="gh-card-excerpt is-body{{#has tag="#micro"}} is-short-excerpt{{/has}}">
                                    {{excerpt}}
                                </p>
                            {{/if}}
                        {{/unless}}

                    {{/has}}

                {{/has}}

            {{/has}}

            {{!-- Date doubles as the permalink to this post --}}
            <footer class="gh-card-meta">
                <a
                    class="gh-card-permalink"
                    href="{{url}}"
                    aria-label="Permalink to {{title}}"
                >
                    <time datetime="{{date format="YYYY-MM-DD"}}">
                        {{date format="D MMM YYYY"}}
                    </time>
                </a>
            </footer>

        </div>

    </div>

</article>