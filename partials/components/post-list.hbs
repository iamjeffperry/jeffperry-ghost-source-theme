{{!--
    JeffPerry.me chronological stream.

    Parameters:
    * feed (index, home, archive)
    * showTitle (true, false)
    * showSidebar (true, false)
--}}

<section class="gh-container jp-stream-container gh-outer">
    <div class="gh-container-inner gh-inner">

        <main class="gh-main jp-stream-main">
            <div class="gh-feed jp-stream">

                {{!-- Homepage: always show the newest posts in strict chronological order. --}}
                {{#match feed "home"}}
                    {{#get "posts" include="authors,tags" limit=@config.posts_per_page}}
                        {{#foreach posts}}
                            {{> "post-card" lazyLoad=true}}
                        {{/foreach}}
                    {{/get}}
                {{/match}}

                {{!-- Main index / paginated archive. --}}
                {{#match feed "index"}}
                    {{#foreach posts}}
                        {{> "post-card" lazyLoad=true}}
                    {{/foreach}}
                {{/match}}

                {{!-- Tag and author pages. --}}
                {{#match feed "archive"}}
                    {{#foreach posts}}
                        {{> "post-card" lazyLoad=true}}
                    {{/foreach}}
                {{/match}}

            </div>

            {{#match pagination.pages ">" 1}}
                <div class="gh-more jp-more-posts is-title">
                    <a href="{{@site.url}}/page/2/">Older posts {{> "icons/arrow"}}</a>
                </div>
            {{/match}}
        </main>

    </div>
</section>
