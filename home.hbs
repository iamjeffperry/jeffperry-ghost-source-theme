{{!< default}}

<section class="jp-home-intro gh-outer">
    <div class="jp-home-intro-inner gh-inner">
        <div class="jp-home-intro-copy">
            <h1 class="jp-home-title is-title">{{@site.title}}</h1>
            {{#if @site.description}}
                <p class="jp-home-description is-body">{{@site.description}}</p>
            {{/if}}
        </div>

        <div class="jp-home-tools">
            <a href="{{@site.url}}/archive/">Archive</a>
            <a href="{{@site.url}}/rss/">RSS</a>
            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <a href="#/portal/signup" data-portal="signup">Subscribe</a>
                {{/unless}}
            {{/if}}
        </div>
    </div>
</section>

{{> "components/post-list" feed="home" showTitle=false showSidebar=false}}
